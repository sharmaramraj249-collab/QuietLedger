pragma language_version 0.23;

import CompactStandardLibrary;

// Each worker deploys one personal listening-window contract through their wallet.
// The deployment registers only their local credential commitment, never their identity
// or raw workplace response.
export ledger eligibleCommitments: Set<Bytes<32>>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger activeWindow: Uint<64>;
export ledger signalCount: Counter;

witness nullifierSecret(): Bytes<32>;

pure circuit credentialFor(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "quiet-ledger:credential"), secret]);
}

constructor(window: Uint<64>) {
  activeWindow = disclose(window);
  // DELIBERATE DISCLOSURE: a one-way credential commitment initializes only
  // this personal contract. The credential secret remains browser-local.
  eligibleCommitments.insert(disclose(credentialFor(nullifierSecret())));
}

pure circuit nullifierFor(window: Uint<64>, secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "quiet-ledger:signal:nullifier"), window as Bytes<32>, secret]);
}

// Public `window` prevents an old proof from being used in a later listening period.
// The witness commitment proves the worker belongs to the published eligibility set.
export circuit submitSignal(window: Uint<64>): [] {
  assert(window == activeWindow, "Listening window is not active");
  // DELIBERATE DISCLOSURE: membership operates on the same one-way commitment
  // published by this personal contract's constructor, never on the secret.
  assert(eligibleCommitments.member(disclose(credentialFor(nullifierSecret()))), "Credential is not eligible");
  const nullifier = nullifierFor(window, nullifierSecret());
  assert(!usedNullifiers.member(disclose(nullifier)), "A signal already exists for this window");
  // DELIBERATE DISCLOSURE: only a window-scoped one-way nullifier is stored publicly.
  // It prevents replay without revealing the credential, secret, worker, or response.
  usedNullifiers.insert(disclose(nullifier));
  signalCount.increment(1);
}
